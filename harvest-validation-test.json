      "id": "harvest-validation-test-A",
      "uri": "https://www.provincia.tn.it/api/openapi/dati-e-statistiche/dataset/5543af8464581f93b4d63992385efe3c#Societa-sportive-che-aderiscono-al-progetto-Voucher-sportivo-2026",
